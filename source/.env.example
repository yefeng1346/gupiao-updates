# 火山方舟 Chat API
# 请在本地复制为 .env 后填写，不要把真实 Key 写进代码或提交到 Git。
ARK_API_KEY=
# Doubao 专用 API Key；填写后 Doubao 使用此 Key，留空则回退到上面的 ARK_API_KEY。
ARK_DOUBAO_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=deepseek-v4-pro-ga-260813
# 页面中可选的豆包模型；与 ARK_MODEL 共用同一个 ARK_API_KEY。
ARK_DOUBAO_MODEL=doubao-seed-2-1-pro-260628
# 读取超时秒数；模型偶尔响应较慢时可调大，范围 10-180。
ARK_TIMEOUT_SECONDS=180
# 思考模式：disabled / enabled / auto
ARK_THINKING_TYPE=disabled
# 火山方舟允许的最大输出长度，当前程序上限为 4096。
ARK_MAX_TOKENS=4096
# 是否读取系统代理；默认关闭，避免 VPN/代理导致本地请求异常。
ARK_USE_ENV_PROXY=false

# 行情数据：akshare/efinance 不需要 Token；tdx 使用本机通达信文件或通达信协议；
# tdx_online 只使用通达信网络协议；tdx_standard 只读取通达信普通版本地目录。
# 可选值：akshare、efinance、tdx、tdx_online 或 tdx_standard。
# 页面里可以直接切换数据源，不必每次修改 .env。
MARKET_PROVIDER=akshare
DEFAULT_SECTOR_TYPE=concept
# 公共行情网络模式：auto=有代理变量时优先代理，否则直连；也可强制 env 或 direct。
MARKET_HTTP_MODE=auto

# efinance's raw full-market fallback has no reliable timeout and is disabled
# by default. Leave this at 0 for normal use; only enable it for diagnostics.
EFINANCE_ALLOW_SLOW_FALLBACK=0

# 当 MARKET_PROVIDER=tdx 或 tdx_standard 时使用。优先填写通达信安装根目录，目录内应有
# T0002\hq_cache\tdxzs.cfg 和/或 vipdoc\sz\lday\sz880xxx.day。
TDX_ROOT=
# 可选的通达信行情服务器，逗号分隔；留空使用内置列表。
TDX_SERVERS=

# 本地存储
DATABASE_PATH=data/gupiao.db
REPORT_DIR=reports

# 计算参数
RPS_WINDOW=50
# 同步并发；8 在当前网络下比 4 更快，过高可能触发上游限速。
AKSHARE_WORKERS=8
# 板块目录同步的外层等待时间，AkShare 网络波动时可适当调大（30-180 秒）。
MARKET_CATALOG_TIMEOUT_SECONDS=120

# 每次打开工具后自动同步一次收盘数据；默认关闭，设为 true 可开启。
AUTO_SYNC_ON_OPEN=false

# 可选：每天到点自动同步收盘数据。默认关闭。
# 开启后，工具运行期间会在指定时间同步概念和行业板块。
AUTO_CLOSE_SYNC=false
AUTO_CLOSE_SYNC_TIME=15:05
AUTO_CLOSE_SYNC_TYPES=concept,industry

# 独立资金归档：软件打开时15:10后自动采集并复核；与行情同步开关无关。
AUTO_FLOW_ARCHIVE=true
# 发布方取得分发授权并部署后才能启用的历史库索引；用户不必自行配置。
FLOW_FEED_URLS=

# 在线更新（可选）：填写公开 HTTPS 的 latest.json 地址，例如 GitHub Raw 地址。
# 留空使用内置GitHub更新地址；更新不覆盖 .env、data 或 reports。
UPDATE_MANIFEST_URL=
UPDATE_CHECK_ON_STARTUP=true
